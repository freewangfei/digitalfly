[Unit]
Description=Digital Fly web console
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/code/guoying
Environment=MUJOCO_GL=egl
ExecStart=/root/anaconda3/envs/digitalfly/bin/python cli.py web --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=append:/var/log/digitalfly.log
StandardError=append:/var/log/digitalfly.log

[Install]
WantedBy=multi-user.target
